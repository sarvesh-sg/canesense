# Copy to .env for local runs. Never commit .env.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash
# Optional: Agent Engine instance for sessions and memory (ADK agentengine:// services)
# AGENT_ENGINE=projects/<project>/locations/asia-south1/reasoningEngines/<id>
